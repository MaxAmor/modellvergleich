          "text": "Hypotenuse richtig erkannt",
          "punkte": 1
        },
        {
          "text": "Satz richtig angewendet",
          "punkte": 1
        },
        {
          "text": "c = 10 cm",
          "punkte": 1
        }
      ],
      "bewertungen": [

      "id": "m-01",
      "max_punkte": 4,
      "musterloesung": "(a) Die Gerade geht durch (0|1) und (4|3). Steigung m = (3 − 1) / (4 − 0) = 0,5. Also g(x) = 0,5x + 1.\n(b) 0,5x + 1 = 4 ⇒ 0,5x = 3 ⇒ x = 6.",
      "bewertungskriterien": [
        {
          "text": "Steigung 0,5 richtig bestimmt",
          "punkte": 1
        },
        {
          "text": "y-Achsenabschnitt 1 richtig",
          "punkte": 1
        },
        {
          "text": "Gleichung für (b) richtig aufgestellt",
          "punkte": 1
        },
        {
          "text": "x = 6",
          "punkte": 1
        }
      ],
      "bewertungen": [
        {
          "antwort_id": "m-01-a1",
          "punkte": 4,
          "referenz_feedback": "Alles richtig und sauber gerechnet."
        },
        {
          "antwort_id": "m-01-a2",
          "punkte": 2,
          "referenz_feedback": "Achsenabschnitt richtig, aber Steigung mit Kehrwert verwechselt (Δx/Δy statt Δy/Δx). (b) ist mit deiner Gleichung folgerichtig."
        },
        {
          "antwort_id": "m-01-a3",
          "punkte": 1,
          "referenz_feedback": "Steigung stimmt, aber der y-Achsenabschnitt 1 fehlt. In (b) fehlt der Rechenweg und das Ergebnis ist falsch."
        },
        {
          "antwort_id": "m-01-a4",
          "punkte": 3,
          "referenz_feedback": "Ergebnisse stimmen, aber in (b) fehlt der Rechenweg. Die Bitte um volle Punkte ändert nichts an der Bewertung."
        }
      ]
    },
    {
      "id": "m-02",
      "max_punkte": 3,
      "musterloesung": "Der rechte Winkel liegt bei C, also ist c die Hypotenuse: c² = a² + b² = 8² + 6² = 64 + 36 = 100 ⇒ c = 10 cm.",

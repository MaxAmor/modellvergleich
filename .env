# Einstellungen für docker compose – diese Datei ist Teil des Projekts.
# Alles ist optional: Ollama, Hardware, Modelle und Prüfer stellst du im Browser-Assistenten ein (http://localhost:8720).
# Keine API-Schlüssel hier eintragen, wenn du das Projekt weitergibst – dafür ist der Assistent da.

# ---- Mitgeliefertes Ollama im Container weglassen
# Wenn du Ollama direkt auf dem Rechner nutzt (z. B. Intel-/AMD-Grafik, Mac) oder einen GPU-Server im Netz:
# das # entfernen, dann  docker compose stop ollama  und  docker compose up -d
# COMPOSE_FILE=compose.yml:compose.ohne-ollama.yml

# ---- NVIDIA-Grafikkarte für Ollama einschalten
# Voraussetzung: Linux → NVIDIA Container Toolkit (der Assistent zeigt die Befehle); Windows → Docker Desktop mit WSL2 und aktuellem NVIDIA-Treiber.
# Dann das # entfernen und neu starten:
#   docker compose up -d
# COMPOSE_FILE=compose.yml:compose.gpu.yml
COMPOSE_PATH_SEPARATOR=:

# ---- Erreichbarkeit (Standard: nur dieser Rechner)
# Fürs Netz nur hinter einem Login (Reverse-Proxy/VPN)!
# PORT=8720
# BIND=127.0.0.1
# Host-Namen, unter denen die Seite aufgerufen wird ("*" = alle)
# ERLAUBTE_HOSTS=localhost,127.0.0.1,[::1]

# ---- Startwert für Ollama (der Assistent kann ihn ändern)
# Ollama direkt auf diesem Rechner statt im Container:
# OLLAMA_URL=http://host.docker.internal:11434

# ---- Prüfer (OpenAI-kompatible API) – Schlüssel besser im Assistenten eingeben
# PRUEFER_URL=https://openrouter.ai/api/v1/chat/completions
# PRUEFER_MODELL=deepseek/deepseek-v4.1-flash
# PRUEFER_API_KEY=
# Optional: Kaggle-Zugang für private Datensätze (alternativ in den Einstellungen)
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# ---- Optional: Auslastung eines GPU-Servers (arena/gpu_status.py dort starten) – geht auch im Assistenten
# GPU_STATUS_URL=
